{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git show*)",
      "PowerShell(git branch -a*)",
      "PowerShell(git branch -v*)",
      "PowerShell(git branch --list*)",
      "PowerShell(git worktree list*)",
      "PowerShell(git remote -v*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git rev-list*)",
      "PowerShell(git merge-base*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git ls-remote*)",
      "PowerShell(pnpm typecheck*)",
      "PowerShell(pnpm lint*)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm build*)",
      "PowerShell(node scripts/verify-docs.mjs*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git worktree list*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(node scripts/verify-docs.mjs*)"
    ],
    "ask": [
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git tag*)",
      "PowerShell(git checkout*)",
      "PowerShell(git switch*)",
      "PowerShell(git stash*)",
      "PowerShell(git fetch*)",
      "PowerShell(git reset*)",
      "PowerShell(git restore*)",
      "PowerShell(pnpm install*)",
      "PowerShell(pnpm add*)",
      "PowerShell(pnpm remove*)",
      "PowerShell(vercel*)",
      "PowerShell(npx vercel*)",
      "PowerShell(pnpm dlx vercel*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git tag*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)"
    ],
    "deny": [
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git rebase*)",
      "PowerShell(git clean*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git update-ref -d*)",
      "PowerShell(git branch -D*)",
      "PowerShell(vercel --prod*)",
      "PowerShell(vercel deploy --prod*)",
      "PowerShell(vercel promote*)",
      "PowerShell(vercel alias*)",
      "PowerShell(vercel remove*)",
      "PowerShell(vercel env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(git filter-branch*)",
      "Bash(git branch -D*)",
      "Bash(vercel --prod*)",
      "Bash(vercel promote*)",
      "Bash(vercel alias*)",
      "Bash(vercel remove*)",
      "Bash(vercel env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.vercel/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.vercel/**)"
    ]
  }
}
